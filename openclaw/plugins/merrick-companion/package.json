{
  "name": "@simoncheungai/merrick-companion",
  "version": "0.1.1",
  "description": "Read-only OpenClaw companion for checking a local MERRICK macOS host.",
  "license": "MIT",
  "homepage": "https://getmerrick.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShengningZ/MERRICK.git",
    "directory": "openclaw/plugins/merrick-companion"
  },
  "bugs": {
    "url": "https://github.com/ShengningZ/MERRICK/issues"
  },
  "keywords": [
    "openclaw",
    "merrick",
    "macos",
    "desktop-assistant",
    "plugin"
  ],
  "type": "module",
  "private": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "npm run build && openclaw plugins validate --entry ./dist/index.js",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "PRIVACY.md",
    "SECURITY.md",
    "LICENSE",
    "assets/icon.png"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "openclaw": "2026.8.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.8.1"
    }
  }
}
